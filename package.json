{
  "name": "mermaid-validator",
  "version": "0.3.2",
  "private": false,
  "description": "Canonical Mermaid validator with configurable rules and safe fixes",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanbaiw/mermaid-validator.git"
  },
  "bugs": {
    "url": "https://github.com/sanbaiw/mermaid-validator/issues"
  },
  "homepage": "https://github.com/sanbaiw/mermaid-validator#readme",
  "keywords": [
    "mermaid",
    "validator",
    "linter",
    "cli"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.30.1",
  "publishConfig": {
    "access": "public"
  },
  "exports": {},
  "bin": {
    "mermaid-validator": "./dist/cli/main.js"
  },
  "files": [
    "dist/cli",
    "dist/validation",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "package:smoke": "node scripts/package-smoke.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build && vitest run",
    "hygiene": "pnpm build && node dist/compatibility/hygiene.js",
    "compatibility": "pnpm build && vitest run tests/compatibility",
    "compatibility:update": "pnpm build && vitest run tests/compatibility -u",
    "check": "pnpm typecheck && pnpm build && node dist/compatibility/hygiene.js && vitest run"
  },
  "dependencies": {
    "commander": "15.0.0",
    "globby": "16.2.2",
    "jsdom": "26.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "11.16.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mermaid-lint/core": "0.35.0",
    "@mermanjs/web": "0.7.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vscode-languageserver": "10.1.0",
    "vscode-languageserver-textdocument": "1.0.12",
    "vitest": "4.1.10"
  }
}
