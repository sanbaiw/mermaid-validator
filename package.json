{
  "name": "mermaid-diagram-validator",
  "version": "0.2.0",
  "private": true,
  "description": "Canonical Mermaid validator with configurable rules and safe fixes",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.30.1",
  "bin": {
    "mermaid-validator": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build && vitest run",
    "hygiene": "pnpm build && node dist/compatibility/hygiene.js",
    "compatibility": "pnpm build && vitest run tests/compatibility",
    "compatibility:update": "pnpm build && vitest run tests/compatibility -u",
    "check": "pnpm typecheck && pnpm build && node dist/compatibility/hygiene.js && vitest run"
  },
  "dependencies": {
    "commander": "15.0.0",
    "globby": "16.2.2",
    "jsdom": "26.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "11.16.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mermaid-lint/core": "0.35.0",
    "@mermanjs/web": "0.7.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
